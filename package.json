{
  "name": "braitenberg-vehicles",
  "version": "0.3.0",
  "description": "Braitenberg Vehicles simulator - client-side SPA",
  "type": "module",
  "scripts": {
    "test": "node --test 'tests/*.test.js'",
    "sync": "node scripts/sync-config.mjs",
    "build": "node scripts/sync-config.mjs && rm -rf public/src && ln -s ../src public/src",
    "serve": "npm run build && node scripts/serve.mjs",
    "serve:coop": "node scripts/serve-session.mjs",
    "smoke": "node tests/smoke/editor.ui.mjs && node tests/smoke/world.sim.mjs && node tests/smoke/proto.crud.mjs && node tests/smoke/neurons.outputs.mjs",
    "smoke:editor": "node tests/smoke/editor.ui.mjs",
    "smoke:world": "node tests/smoke/world.sim.mjs",
    "smoke:crud": "node tests/smoke/proto.crud.mjs",
    "smoke:neurons": "node tests/smoke/neurons.outputs.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "matter-js": "^0.20.0"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
